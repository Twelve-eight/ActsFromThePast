<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Alchyr.Sts2.BaseLib" Version="3.3.6" />
      <PackageReference Include="GodotSharp" Version="4.6.0-dev.5" />
      <PackageReference Include="Lib.Harmony" Version="2.4.2" />
      <AdditionalFiles Include="ActsFromThePast/localization/**/*.json"/>
    </ItemGroup>

    <ItemGroup>
      <Reference Include="sts2">
        <HintPath>G:/steam/steamapps/common/Slay the Spire 2/data_sts2_windows_x86_64/sts2.dll</HintPath>
      </Reference>
    </ItemGroup>

    <!-- 本机移植：产物走 stage，不直接进 live mods（避免与工坊版同 id 冲突、避免污染运行环境） -->
    <PropertyGroup>
      <AftpStage>G:/omp works/aftp-stage/</AftpStage>
    </PropertyGroup>
    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
      <MakeDir Directories="$(AftpStage)"/>
      <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AftpStage)"/>
      <Copy SourceFiles="ActsFromThePast.json" DestinationFolder="$(AftpStage)"/>

    </Target>

</Project>
